# Alpaca PAPER-trading keys (https://app.alpaca.markets -> Paper account -> API keys).
# Export these in your shell (or load this file with your own tooling); never commit real values.
# The backtest only uses them to download historical news headlines.
ALPACA_API_KEY=
ALPACA_API_SECRET=
# Must stay true. Setting it to false makes the bot refuse to start: live trading is not supported.
ALPACA_PAPER=true
